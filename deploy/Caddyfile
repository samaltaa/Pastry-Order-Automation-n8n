{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$N8N_DOMAIN} {
	import common
	reverse_proxy n8n:5678
}

{$STATUS_DOMAIN} {
	import common
	reverse_proxy uptime-kuma:3001
}

# Public demo of the POS -> Shopify sync. Only the demo page and health check are exposed;
# the rest of sync-api (mappings, sync, commands) stays internal to n8n.
{$SYNC_DOMAIN} {
	import common
	@public path /demo /demo/* /health
	handle @public {
		request_body {
			max_size 300KB
		}
		reverse_proxy sync-api:3002
	}
	handle {
		redir * /demo
	}
}
