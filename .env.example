# Database
POSTGRES_DB=pastry_ops
POSTGRES_USER=pastry
POSTGRES_PASSWORD=replace_with_long_random_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pastry:replace_with_long_random_password@postgres:5432/pastry_ops

# Local development ports
API_PORT=3001
N8N_PORT=5678

# n8n (generate the key once with: openssl rand -hex 32, and never change it)
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
WEBHOOK_URL=http://localhost:5678/

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_openssl_rand_hex_16
OWNER_TELEGRAM_CHAT_ID=replace_me

# Claude
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5

# API
OPS_API_KEY=replace_with_openssl_rand_hex_32
CHAT_RATE_LIMIT_PER_MINUTE=6
DAILY_LLM_BUDGET_USD=2

# Production (VPS)
N8N_DOMAIN=n8n.example.com
STATUS_DOMAIN=status.example.com
ACME_EMAIL=you@example.com

# Backups (any S3-compatible storage, e.g. Cloudflare R2 or Backblaze B2)
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=pastry-ops-backups
BACKUP_S3_ACCESS_KEY_ID=replace_me
BACKUP_S3_SECRET_ACCESS_KEY=replace_me
BACKUP_HEARTBEAT_URL=
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30
