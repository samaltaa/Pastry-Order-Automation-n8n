# Database
POSTGRES_DB=pastry_ops
POSTGRES_USER=pastry
POSTGRES_PASSWORD=replace_with_long_random_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pastry:replace_with_long_random_password@postgres:5432/pastry_ops

# Local development ports
API_PORT=3001
N8N_PORT=5678

# n8n (generate the key once with: openssl rand -hex 32, and never change it)
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
WEBHOOK_URL=http://localhost:5678/

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_openssl_rand_hex_16
OWNER_TELEGRAM_CHAT_ID=replace_me

# Claude
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5

# API
OPS_API_KEY=replace_with_openssl_rand_hex_32
CHAT_RATE_LIMIT_PER_MINUTE=6
DAILY_LLM_BUDGET_USD=2

# Production (VPS)
N8N_DOMAIN=n8n.example.com
STATUS_DOMAIN=status.example.com
ACME_EMAIL=you@example.com

# Backups (any S3-compatible storage, e.g. Cloudflare R2 or Backblaze B2)
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=pastry-ops-backups
BACKUP_S3_ACCESS_KEY_ID=replace_me
BACKUP_S3_SECRET_ACCESS_KEY=replace_me
BACKUP_HEARTBEAT_URL=
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30

# Shopify POS sync (Dev Dashboard app: client credentials grant)
SHOPIFY_STORE=pastry-sync-demo.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Optional: skips looking up the first location on each run
SHOPIFY_LOCATION_ID=

# Public demo page for reviewers (sync.<domain>/demo). Off unless true.
DEMO_ENABLED=false
SYNC_DOMAIN=sync.example.com
STOREFRONT_URL=https://pastry-sync-demo.myshopify.com
STOREFRONT_PASSWORD=

# Where the inventory lives: a POS table (articulos) or the Google Sheet Make sends (sheets.inventory).
# Only this source is synced, so the POS and the sheet never overwrite each other's stock.
SYNC_SOURCE=articulos
# Google Sheet pipeline (Make). Make sends the sheet with this key; empty turns the endpoint off.
# Generate one with: openssl rand -hex 24
SHEET_INGEST_KEY=
# Make's custom webhook that writes demo edits back into the sheet
MAKE_SHEET_WEBHOOK_URL=
# Link to the sheet, shown on the demo page
SHEET_URL=
# Where Shopify sends stock changes (online sales, cancellations, admin edits). sync-api registers
# it with Shopify at startup, e.g. https://sync.example.com/webhooks/shopify
SHOPIFY_WEBHOOK_URL=
# A sheet's new mapping is approved without the owner when every deterministic check passes
# (sync-api/app/gate.py); one that fails any check waits for /approve in Telegram.
AUTO_APPROVE_MAPPINGS=true
