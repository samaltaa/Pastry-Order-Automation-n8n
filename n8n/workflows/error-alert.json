{
  "id": "pastryErrorAlert",
  "name": "Error alert",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "error-trigger",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "alert-owner",
      "name": "Alert owner",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        240,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "pastryTelegramBot",
          "name": "Pastry Telegram bot"
        }
      },
      "parameters": {
        "chatId": "={{ $env.OWNER_TELEGRAM_CHAT_ID }}",
        "text": "={{ '⚠️ Workflow failed: ' + $json.workflow.name + '\\nNode: ' + ($json.execution.lastNodeExecuted || 'unknown') + '\\nError: ' + ($json.execution.error?.message || 'unknown') + ($json.execution.url ? '\\n' + $json.execution.url : '') }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "log-event",
      "name": "Log event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://ops-api:3001/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.OPS_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'workflow_error', source: $json.workflow.name, detail: { execution_id: $json.execution.id, node: $json.execution.lastNodeExecuted, error: $json.execution.error?.message } }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Alert owner",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}