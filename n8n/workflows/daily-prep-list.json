{
  "id": "pastryDailyPrepList",
  "name": "Daily prep list",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "cron",
      "name": "Every day 6am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "prep-list",
      "name": "Get prep list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://ops-api:3001/reports/prep-list",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.OPS_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "send-prep",
      "name": "Send prep list",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "pastryTelegramBot",
          "name": "Pastry Telegram bot"
        }
      },
      "parameters": {
        "chatId": "={{ $env.OWNER_TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Every day 6am": {
      "main": [
        [
          {
            "node": "Get prep list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get prep list": {
      "main": [
        [
          {
            "node": "Send prep list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}